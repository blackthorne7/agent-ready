# Runtime: "omnara" (Omnara runs the loop, lib/agent/omnara.ts) or unset for the direct loop (lib/agent/model.ts)
AGENT_RUNTIME=omnara

# Omnara (lib/agent/omnara.ts). Use an org API key (omnara_org_v1_...).
OMNARA_TOKEN=
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
# OMNARA_PROVIDER=omnara-openrouter
# OMNARA_MODEL=anthropic/claude-opus-5.5

# Direct loop model provider (lib/agent/model.ts)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# Supabase (lib/agent/persist.ts). Leave empty to skip writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stub mode: no model, fake steps for frontend work
# AGENT_STUB=1
# AGENT_STUB_DELAY_MS=700

# Guardrail overrides (defaults 15000 / 120000)
# AGENT_TOOL_TIMEOUT_MS=15000
# AGENT_RUN_TIMEOUT_MS=120000

# Context.dev (src/lib/context-dev.ts): brand details for fix plans, business categories, leaderboard logos.
CONTEXT_DEV_API_KEY=
# Logo Link public client id (safe in pages; restrict its referring domains in the Context.dev dashboard)
LOGOLINK_CLIENT_ID=
