# Runtime: "omnara" (Omnara runs the loop, src/lib/agent/omnara.ts) or unset for the direct loop (src/lib/agent/model.ts)
AGENT_RUNTIME=omnara

# Omnara (src/lib/agent/omnara.ts). Use an org API key (omnara_org_v1_...).
OMNARA_TOKEN=
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
# OMNARA_PROVIDER=omnara-openrouter
# OMNARA_MODEL=anthropic/claude-opus-5.5

# Direct loop model provider (src/lib/agent/model.ts)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# Supabase (src/lib/agent/persist.ts). Leave empty to skip writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stub mode: no model, fake steps for frontend work
# AGENT_STUB=1
# AGENT_STUB_DELAY_MS=700

# New agent runs allowed per day across all visitors (default 50). Past it, new sites are scored
# from the checklist only. Counted in memory, so a restart or deploy resets it.
# AGENT_DAILY_BUDGET=50

# Guardrail overrides (defaults 15000 / 120000)
# AGENT_TOOL_TIMEOUT_MS=15000
# AGENT_RUN_TIMEOUT_MS=120000

# Context.dev (src/lib/context-dev.ts): brand details for fix plans, business categories, leaderboard logos.
CONTEXT_DEV_API_KEY=
# Logo Link public client id (safe in pages; restrict its referring domains in the Context.dev dashboard)
LOGOLINK_CLIENT_ID=

# Stripe (src/lib/payments.ts): charges $9 to export a site's fix link. Test keys only (sk_test_...);
# a live key is refused. Empty = no paywall, fix links stay free. Pay with card 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
# Public address Stripe sends payers back to after checkout (never taken from the request's Host header).
# Defaults to the live site; localhost uses itself.
# SITE_URL=https://agentready.sfo.unikraft.app
